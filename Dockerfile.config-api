# ---------- Stage: builder ----------
# Install config-api dependencies with hash verification.
# Build context must be the repo root so lib/ and config files are available.
FROM python:3.13-alpine@sha256:399babc8b49529dabfd9c922f2b5eea81d611e4512e3ed250d75bd2e7683f4b0 AS builder

WORKDIR /build

COPY config-api/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir --require-hashes --prefix=/install -r /tmp/requirements.txt && \
    rm /tmp/requirements.txt

# ---------- Stage: runtime ----------
FROM python:3.13-alpine@sha256:399babc8b49529dabfd9c922f2b5eea81d611e4512e3ed250d75bd2e7683f4b0

# Security: run as non-root
ARG UID=1000
ARG GID=1000
RUN addgroup -g ${GID} configapi && \
    adduser -u ${UID} -G configapi -s /bin/sh -D configapi

WORKDIR /app

# Copy installed packages from builder
COPY --from=builder /install /usr/local

# Copy config API package
COPY config-api/config_api/ /app/config_api/

# Copy lib/ from MCP server (for ConfigManager import)
COPY lib/ /app/lib/

# Replace lib/__init__.py with a minimal version that only imports
# stdlib-only modules needed by the config API (no prometheus_client,
# fastmcp, watchdog, or other heavy dependencies).
COPY config-api/stubs/lib_init_minimal.py /app/lib/__init__.py

# Copy config schema and default config (needed by ConfigManager)
COPY config.schema.json /app/config.schema.json
COPY default-config.json /app/default-config.json

# Create config directory (will be mounted as volume)
RUN mkdir -p /config && chown configapi:configapi /config

# Switch to non-root user
USER configapi

EXPOSE 8081

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD wget --spider -q http://localhost:8081/health || exit 1

CMD ["python", "-m", "config_api.app"]
