{
  "$schema": "./config.schema.json",
  "version": 1,
  "ssh_targets": {
    "example-server-1": {
      "host": "server1.example.com",
      "port": 22,
      "username": "admin",
      "private_key": "/app/ssh_key",
      "checkcommand": "echo ping"
    },
    "example-server-2": {
      "host": "192.168.1.100",
      "port": 22,
      "username": "root",
      "private_key": "/app/ssh_key",
      "checkcommand": "echo ping"
    }
  },
  "block_patterns": [
    "\\bsudo\\b",
    "\\brm\\s+-rf\\b",
    "\\bdd\\s+if=",
    "\\b>:.*/(dev|proc|sys)/",
    "\\bmkfs\\.",
    "\\bwipefs\\b",
    "\\bshutdown\\b",
    "\\breboot\\b",
    "\\bpoweroff\\b",
    "\\binit\\s+[06]",
    "\\bhalt\\b"
  ],
  "allowed_commands": {
    "default": [
      {
        "targets": ["*"],
        "commands": [
          "hostname", "uptime", "free", "df", "du",
          "docker", "docker-compose", "systemctl", "journalctl",
          "kubectl", "ps", "top", "htop",
          "ls", "cat", "head", "tail", "grep", "find", "wc",
          "ss", "netstat", "ip", "ping",
          "curl", "wget",
          "echo", "date", "who", "id",
          "lsof", "mount", "smartctl", "lsblk"
        ]
      }
    ],
    "api_keys": [],
    "networks": []
  },
  "settings": {
    "max_output_length": 50000,
    "command_timeout_max": 120,
    "retry_max_attempts": 3,
    "retry_backoff_base_seconds": 1.0,
    "circuit_breaker_failure_threshold": 5,
    "circuit_breaker_timeout_seconds": 60.0,
    "log_level": "INFO",
    "max_log_output": 4096,
    "compress_rotated": true,
    "pool_max_connections_per_target": 5,
    "pool_idle_timeout_seconds": 300.0,
    "pool_cleanup_interval_seconds": 60.0,
    "max_concurrent_ssh_connections": 20,
    "watcher_debounce_seconds": 2.0,
    "trusted_proxies": [],
    "sftp": {
      "sandbox_root": "/",
      "max_path_length": 4096
    }
  }
}
