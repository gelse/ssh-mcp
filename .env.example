# Set to 'true' to enable the config API (default: false)
CONFIG_API_ENABLED=false

# Config API authentication token (required when CONFIG_API_ENABLED=true)
# Generate with: openssl rand -hex 32
CONFIG_API_TOKEN=46fcd4f3971f332495f65fda0457396b193dae989996cdf2898058767aa4dede

# Set to false for HTTP-only environments (no TLS). Default: true (HTTPS required).
# CONFIG_API_SESSION_COOKIE_SECURE=true

# Optional: override container UID/GID for mcp-ssh service
# UID=1000
# GID=1000
